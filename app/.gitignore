.pub-cache/
.pub/
/build/

# Platform folders (android/, ios/) are committed — see their own
# .gitignore files for build-artifact exclusions within each. /web/ is
# regenerated ad hoc via `flutter create . --platforms web` for the
# GitHub Pages preview deploy, except flutter_bootstrap.js -- that one
# file disables the default service-worker registration (see its own
# comment) and must survive regeneration or every future preview
# rebuild silently reintroduces the "redeploys look cached" bug.
# index.html/manifest.json are committed too, for the same reason --
# `flutter create` only regenerates files that aren't already present,
# so committing our customized app name/title here (instead of
# Flutter's generic "wyn"/"A new Flutter project" template values)
# means every future CI deploy keeps it instead of silently reverting.
# favicon.png/icons/ are committed for the identical reason: without
# this they'd be Flutter's generic template icon (or wiped back to it
# on every redeploy) instead of the real WYNOS logo (2026-08-30).
#
# firebase-messaging-sw.js is committed for a stronger version of the
# same reason (Beta4): it is the browser half of Web Push, and Firebase
# only looks for it at exactly this path. `flutter create` would never
# generate it -- it is not part of Flutter's web template at all -- so
# without this line the file lives only on whoever's machine wrote it,
# and every deploy ships a build where background push has nowhere to
# be delivered. This was caught before the first Beta4 deploy, not
# after: `git ls-files app/web/` did not list it.
/web/*
!/web/flutter_bootstrap.js
!/web/firebase-messaging-sw.js
!/web/index.html
!/web/manifest.json
!/web/favicon.png
!/web/icons/
!/web/icons/Icon-192.png
!/web/icons/Icon-512.png
!/web/icons/Icon-maskable-192.png
!/web/icons/Icon-maskable-512.png
/linux/
/macos/
/windows/

# Symbolication / obfuscation related
app.*.symbols
app.*.map.json

# Secrets — never commit real Supabase keys or other credentials
*.env
.env
dart_define.json
