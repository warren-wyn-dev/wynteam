# Public browser configuration only. Never put service-role or management keys here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Web Push. Reuse the exact same values already stored as GitHub Actions
# secrets for the Flutter web build (FIREBASE_WEB_API_KEY, FIREBASE_WEB_APP_ID,
# FIREBASE_MESSAGING_SENDER_ID, FIREBASE_PROJECT_ID, FIREBASE_AUTH_DOMAIN,
# FIREBASE_STORAGE_BUCKET, FIREBASE_VAPID_KEY — see .github/workflows/deploy-web.yml)
# rather than provisioning a second Firebase Web app. All public by design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
