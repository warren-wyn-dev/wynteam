# WYNOS Stripe SANDBOX browser-only config.
# Use on a brand-new protected Vercel project; never on the Vercel project "web".
# This is a DOCUMENTATION TEMPLATE. Next.js does not load ".env.stripe-sandbox.example".
NEXT_PUBLIC_WYNOS_STRIPE_SANDBOX=true
NEXT_PUBLIC_SUPABASE_URL=https://pcatuxtenluqzjzzwsvl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_SANDBOX_PUBLISHABLE_KEY

# After preview URL exists, in Supabase Sandbox > Edge Functions > Secrets:
# WYNOS_STRIPE_SANDBOX_FOOD_URL=https://YOUR-PREVIEW.vercel.app/stripe-sandbox
# WYNOS_STRIPE_MERCHANT_TEST_URL=https://YOUR-PREVIEW.vercel.app/merchant
#
# NEVER configure sk_live_ or pk_live_ keys on this test project.
