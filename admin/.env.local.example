# Copy to .env.local and fill in with the real values (Supabase project
# settings -> API). Same Supabase project as the WYN Social app
# (Shared Backend decision, .wyn/company/DECISIONS.md 2026-08-14) --
# use the anon/publishable key here, never the service-role key (this
# file's values end up in the browser bundle).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# WYN-220 AI Secretary (server-only -- never prefix these with NEXT_PUBLIC_).
# Leave AI_SECRETARY_ENABLED unset to keep the feature off in this environment.
# See .wyn/docs/engineering/wyn-220-ai-secretary-architecture.md section 8.
AI_SECRETARY_ENABLED=
ANTHROPIC_API_KEY=
# Optional model overrides per tier:
# AI_MODEL_FAST=
# AI_MODEL_STANDARD=
# AI_MODEL_DEEP=
