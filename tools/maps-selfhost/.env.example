# Copy to .env on the server (never commit .env).
# Domain that points at this server, e.g. maps-core.wynos.online
MAPS_CORE_DOMAIN=maps-core.wynos.online
# Generate with: openssl rand -hex 32  (same value goes to Vercel WYNOS_MAPS_UPSTREAM_TOKEN)
WYNOS_MAPS_UPSTREAM_TOKEN=
# Generate with: openssl rand -hex 24
NOMINATIM_DB_PASSWORD=
